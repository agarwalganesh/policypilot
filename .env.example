# =============================================================
# PolicyPilot — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================

# --- Application ---
FLASK_ENV=development
FLASK_SECRET_KEY=change-this-to-a-long-random-secret
APP_NAME=PolicyPilot
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://policypilot:policypilot@localhost:5432/policypilot
POSTGRES_USER=policypilot
POSTGRES_PASSWORD=policypilot
POSTGRES_DB=policypilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- ChromaDB ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=policy_documents

# --- Google Gemini API (LLM & Embeddings) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# --- RAG Configuration ---
RETRIEVAL_TOP_K=5
EVIDENCE_THRESHOLD=0.65
MIN_SIMILARITY=0.4
MAX_RETRIES=2
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Authentication ---
JWT_SECRET=change-this-to-another-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# --- LangSmith (optional — leave blank to disable tracing) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=policypilot
LANGSMITH_TRACING=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- CORS ---
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=50
UPLOAD_ALLOWED_EXTENSIONS=pdf,docx
DOCUMENTS_RAW_DIR=documents/raw
DOCUMENTS_PROCESSED_DIR=documents/processed
DOCUMENTS_REJECTED_DIR=documents/rejected

# --- Admin ---
ADMIN_EMAIL=admin@physicswallah.com
ADMIN_PASSWORD=Admin@123!Change_This
